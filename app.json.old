{
  "expo": {
    "name": "jam-native",
    "slug": "jam-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-512.png",
    "scheme": "jam-native",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "config": {
        "googleMapsApiKey": "AIzaSyBJ6qISFbEpIIr2w0DqGN10edRf_4g-cl8"
      },
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "bundleIdentifier": "com.davidfiatyorg.jamnative"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDb_wytzaLvox976CxYS0nleh_ahf5myy8"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "package": "com.davidfiatyorg.jamnative"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME)786 to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your media files."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bc105b9c-d776-42e2-bd2e-2ebcff179748"
      }
    },
    "owner": "david-fiaty-org",
    "updates": {
      "url": "https://u.expo.dev/bc105b9c-d776-42e2-bd2e-2ebcff179748"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}